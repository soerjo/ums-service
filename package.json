    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "kafkajs": "^2.2.4",
    "nest-winston": "^1.10.2",
    "nodemailer": "^10.1.7",
